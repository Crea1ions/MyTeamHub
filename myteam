#!/bin/bash

# MyTeamHub Universal Launcher
# Usage: myteam [dev|build|check|stop]
# Default: myteam (start dev mode)

set -e

MYTEAMHUB_DIR="/home/devdipper/dev/APP/001-APP-MyTeamHub"
COMMAND="${1:-dev}"

if [[ ! -d "$MYTEAMHUB_DIR" ]]; then
  echo "❌ Error: MyTeamHub directory not found at $MYTEAMHUB_DIR"
  exit 1
fi

case "$COMMAND" in
  dev|start)
    echo "🚀 Starting MyTeamHub (auto-spawn mode)..."
    cd "$MYTEAMHUB_DIR"
    npm run tauri:dev
    ;;
  
  build)
    echo "🔨 Building MyTeamHub..."
    cd "$MYTEAMHUB_DIR"
    npm run tauri:build
    ;;
  
  check)
    echo "✅ Checking services health..."
    echo ""
    echo "Orchestrator (port 8001):"
    curl -s http://localhost:8001/vault/search?q=.md 2>/dev/null | jq '.results | length' || echo "❌ Not responding"
    echo ""
    echo "Proxy-LLM (port 3001):"
    curl -s http://localhost:3001/health 2>/dev/null | jq '.status' || echo "❌ Not responding"
    echo ""
    echo "Frontend (port 3002):"
    curl -s -o /dev/null -w "HTTP %{http_code}\n" http://localhost:3002/ || echo "❌ Not responding"
    ;;
  
  stop)
    echo "🛑 Stopping MyTeamHub services..."
    pkill -f "orchestrator" || true
    pkill -f "proxy-llm" || true
    pkill -f "astro dev" || true
    pkill -f "tauri" || true
    echo "✓ All services stopped"
    ;;
  
  help|--help|-h)
    echo "MyTeamHub Launcher"
    echo ""
    echo "Usage: myteam [COMMAND]"
    echo ""
    echo "Commands:"
    echo "  dev           Start development mode (default)"
    echo "  build         Build production binary"
    echo "  check         Check services health status"
    echo "  stop          Stop all running services"
    echo "  help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  myteam              # Start dev mode"
    echo "  myteam dev          # Start dev mode"
    echo "  myteam build        # Build production"
    echo "  myteam check        # Check health"
    echo "  myteam stop         # Stop services"
    ;;
  
  *)
    echo "❌ Unknown command: $COMMAND"
    echo "Run 'myteam help' for usage information"
    exit 1
    ;;
esac
